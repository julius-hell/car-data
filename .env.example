# Postgres connection used by the app and by drizzle-kit migrations.
# docker-compose.yml wires the app to the bundled postgres service with this URL.
DATABASE_URL=postgres://cardata:cardata@localhost:5433/cardata

# Credentials for the bundled postgres service (docker-compose.yml).
POSTGRES_USER=cardata
POSTGRES_PASSWORD=cardata
POSTGRES_DB=cardata
# Host port the bundled postgres is published on (5432 is often taken).
POSTGRES_PORT=5433

# Directory car photos are written to. docker-compose.yml mounts a named
# volume here; locally it defaults to ./data/photos when unset.
PHOTO_DIR=./data/photos

# Better Auth (used from the passkey ticket onwards).
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
# Auth endpoints are rate-limited per IP in production (100 requests / 10 s).
# Set to "off" only when running the end-to-end suite against this server.
BETTER_AUTH_RATE_LIMIT=on

# WebAuthn relying party. RP_ID must be the bare hostname the app is served on
# (no scheme or port); passkeys are bound to it. Use "localhost" for local dev.
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Car Data
